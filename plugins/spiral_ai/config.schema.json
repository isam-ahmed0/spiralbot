{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Plugin Config",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "apiKey": { "type": "string", "default": "", "description": "OpenAI API key" },
    "model": { "type": "string", "default": "gpt-3.5-turbo" },
    "systemPrompt": { "type": "string", "default": "You are a helpful Discord bot. Be concise." },
    "trigger": { "type": "string", "default": "!ask", "description": "Command to trigger AI" },
    "maxHistory": { "type": "number", "default": 10, "description": "Max conversation history per user" },
    "cooldown": { "type": "number", "default": 5, "description": "Seconds between requests" }
  }
}