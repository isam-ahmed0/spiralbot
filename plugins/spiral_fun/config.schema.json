{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spiral Fun Config",
  "type": "object",
  "properties": {
    "eightball_responses": {
      "type": "array",
      "default": [
        "It is certain.", "Without a doubt.", "Ask again later.",
        "Very doubtful.", "My reply is no.", "Yes."
      ],
      "description": "Magic 8-ball responses"
    },
    "dice_default_sides": {
      "type": "number",
      "default": 6,
      "description": "Default dice sides"
    },
    "rate_max": {
      "type": "number",
      "default": 10,
      "description": "Maximum rating"
    }
  }
}