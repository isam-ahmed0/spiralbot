{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Counter Plugin Config",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "maxCount": { "type": "number", "default": 1000, "description": "Maximum count value" },
    "minCount": { "type": "number", "default": -1000, "description": "Minimum count value" }
  }
}