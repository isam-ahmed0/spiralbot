{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spiral Moderation Config",
  "type": "object",
  "properties": {
    "max_warnings_before_ban": {
      "type": "number",
      "default": 5,
      "description": "Warnings before auto-ban"
    },
    "default_mute_duration_minutes": {
      "type": "number",
      "default": 5,
      "description": "Default mute duration"
    },
    "log_channel_id": {
      "type": "string",
      "default": "",
      "description": "Channel ID for mod logs"
    }
  }
}