{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presence Plugin Config",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "statusType": {
      "type": "string",
      "enum": ["online", "idle", "dnd", "invisible"],
      "default": "online"
    },
    "activityType": {
      "type": "string",
      "enum": ["Playing", "Listening", "Watching", "Streaming", "Competing"],
      "default": "Playing"
    },
    "statusMessage": {
      "type": "string",
      "default": "Spiral Bot | !help"
    },
    "streamingUrl": {
      "type": "string",
      "default": ""
    },
    "randomRotation": {
      "type": "boolean",
      "default": false,
      "description": "Rotate through multiple status messages"
    },
    "rotationInterval": {
      "type": "number",
      "default": 30000,
      "description": "Time in ms between rotations"
    },
    "rotationMessages": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "List of messages to rotate through"
    }
  }
}