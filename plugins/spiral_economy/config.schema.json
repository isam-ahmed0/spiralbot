{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spiral Economy Config",
  "type": "object",
  "properties": {
    "daily_reward_min": {
      "type": "number",
      "default": 100,
      "description": "Minimum daily reward"
    },
    "daily_reward_max": {
      "type": "number",
      "default": 500,
      "description": "Maximum daily reward"
    },
    "daily_cooldown_hours": {
      "type": "number",
      "default": 24,
      "description": "Hours between daily claims"
    },
    "work_cooldown_minutes": {
      "type": "number",
      "default": 30,
      "description": "Minutes between work sessions"
    },
    "starting_balance": {
      "type": "number",
      "default": 0,
      "description": "Balance for new users"
    },
    "currency_symbol": {
      "type": "string",
      "default": "$",
      "description": "Currency display symbol"
    }
  }
}