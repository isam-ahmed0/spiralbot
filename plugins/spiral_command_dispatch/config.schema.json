{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command Dispatch Plugin Config",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "caseSensitive": {
      "type": "boolean",
      "default": false,
      "description": "Commands are case sensitive"
    },
    "autoDeleteCommand": {
      "type": "boolean",
      "default": false,
      "description": "Auto-delete command messages after execution"
    }
  }
}